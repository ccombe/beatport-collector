# Environment
.env

# Status / session notes
STATUS.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# Virtual environments (per-platform: .venv on Windows, .venv-wsl on WSL —
# set UV_PROJECT_ENVIRONMENT=.venv-wsl on Linux so the two never clash)
.venv
.venv-*

# Beatport session (no longer used, legacy)
beatport_session.json

# Collected data CSVs (track libraries)
*.csv

# Testing
.pytest_cache/
.hypothesis/

# Mutation testing state (incremental cache, regenerable)
mutants/

# Playlists
playlists/
archive/

# Music catalog (rebuilt from scratch each scan)
music_catalog.db
music_catalog.db-shm
music_catalog.db-wal

# IDE
.vscode/
.idea/

# Local scan manifests (regenerable, absolute paths)
sparse_*.json
track_cache*.json
*_progress.jsonl

# Per-run state: progress logs, run logs, manifests. These embed absolute
# paths into the listener's private music library, so they must never be
# committed. Every one is regenerable by rerunning the command.
*.jsonl
*.log
*.err
*_todo*.json
*_apply*.json
gdrive_*

# Temp files left by an interrupted write (cleaned up on the next run)
.enrich-*
.repair-*
.trackcache-*
*.tmp

# Code inspection / visualization (local, regenerable)
.codegraph/
codegraph.html

# Throwaway probes
probe*.*
_verify_tmp.py
_diag*.py
_recover*.py
_cmp*.py
*_tmp.py

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Real batch/apply run output (manifests, progress logs, track snapshots)
runs/
*_tracks.json
