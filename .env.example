# Beatport account credentials (get from https://beatport.com)
BP_USERNAME=
BP_PASSWORD=

# Discogs personal access token -- OPTIONAL.
# https://www.discogs.com/settings/developers -> Generate token
# Leave blank to skip Discogs entirely; the tool works without it.
# Raises the Discogs limit from 25 to 60 req/min and is the only source
# here that can supply genre for tracks Beatport does not carry.
DISCOGS_TOKEN=
